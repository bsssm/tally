{
  "name": "tally-monorepo",
  "private": true,
  "version": "0.0.1",
  "description": "Tally — one ledger for AI inference spend across providers, plus the credits and cheaper routes you're not using.",
  "type": "module",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --filter ./packages/core --filter ./packages/cli build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "tally": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
